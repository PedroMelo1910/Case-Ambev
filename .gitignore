# Microdados e derivados linha a linha NUNCA entram no repositorio (parecer da fase 2, secao 4).
data/raw/
data/processed/*
!data/processed/.gitkeep
data/raw/*
*.parquet
*.zip
*.duckdb
*.sqlite
*.db
*.parcial
*.novo
artifacts/*
!artifacts/.gitkeep
# Excecoes especificas: manifesto congelado v1.3 e os artefatos B0 e L que ele cita (reproducao e auditoria). O resto de
# artifacts/ continua ignorado, inclusive os demais artefatos e o historico de auditoria da execucao.
!artifacts/modelagem_2008/
artifacts/modelagem_2008/*
!artifacts/modelagem_2008/manifesto_congelamento_v1_3.json
!artifacts/modelagem_2008/execucao_6/
artifacts/modelagem_2008/execucao_6/*
!artifacts/modelagem_2008/execucao_6/artefatos/
artifacts/modelagem_2008/execucao_6/artefatos/*
!artifacts/modelagem_2008/execucao_6/artefatos/B0.json
!artifacts/modelagem_2008/execucao_6/artefatos/B0.meta.json
!artifacts/modelagem_2008/execucao_6/artefatos/L.joblib
!artifacts/modelagem_2008/execucao_6/artefatos/L.meta.json
# Versao reduzida (16/11/2026, so 2008): modelo, resumo agregado e hashes. Previsoes por episodio ficam fora.
!artifacts/contexto_reduzido_v1/
artifacts/contexto_reduzido_v1/*
!artifacts/contexto_reduzido_v1/modelo.joblib
!artifacts/contexto_reduzido_v1/resumo.json
!artifacts/contexto_reduzido_v1/meta.json
# Rede neural da jornada (personas): pesos, metadados e avaliacao agregada. Treinada na POF 2008, sem linha a linha.
!artifacts/personas_rede_v1/
artifacts/personas_rede_v1/*
!artifacts/personas_rede_v1/rede.pt
!artifacts/personas_rede_v1/meta.json
!artifacts/personas_rede_v1/avaliacao.json

# Ambiente
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.ruff_cache/
