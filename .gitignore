# Microdados e derivados linha a linha NUNCA entram no repositorio (parecer da fase 2, secao 4).
data/raw/
data/processed/*
!data/processed/.gitkeep
data/raw/*
*.parquet
*.zip
*.duckdb
*.sqlite
*.db
*.parcial
*.novo
artifacts/*
!artifacts/.gitkeep
# Excecao: o artefato publicado do Occasion Score observado (modelo, resumo agregado, metricas e hashes; nenhuma linha
# individual). Sem ele a aplicacao exige refazer o treino com os microdados.
!artifacts/ocasiao_observada_v1/
artifacts/ocasiao_observada_v1/*
!artifacts/ocasiao_observada_v1/modelo.joblib
!artifacts/ocasiao_observada_v1/resumo.json
!artifacts/ocasiao_observada_v1/meta.json
!artifacts/ocasiao_observada_v1/teste.json
!artifacts/ocasiao_observada_v1/desenvolvimento.json
!artifacts/ocasiao_observada_v1/temporal.json
!artifacts/ocasiao_observada_v1/explicacao.json

# Ambiente
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env
.ruff_cache/
